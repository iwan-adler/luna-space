{
  "name": "Luna Space",
  "short_name": "Luna",
  "description": "A private workspace for you and your friends: opportunities, hackathons, projects, calendar, notes and chat.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "background_color": "#120e12",
  "theme_color": "#120e12",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
