# Copy to .env.local (never commit .env.local).
# Only VITE_* variables are bundled into the browser app — never put secrets here.

# Local Supabase (`npm run db:start` prints these) or your hosted project's
# Settings → API → Project URL and publishable/anon key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Phase 5 (Web Push): public VAPID key. The private key goes in Edge Function secrets.
# VITE_VAPID_PUBLIC_KEY=
